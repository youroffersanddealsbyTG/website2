rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ─────────────────────────────────────────────────────────────────────
    // Helper functions
    // ─────────────────────────────────────────────────────────────────────
    function isPhoneVerified() {
      return request.auth != null
          && request.auth.token.phone_number != null
          && request.auth.token.phone_number != '';
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Allowed file types for business documents
    function isValidDocument() {
      return request.resource.contentType.matches('application/pdf')
          || request.resource.contentType.matches('image/(jpeg|png|jpg)');
    }

    // Max 20 MB for document uploads
    function isValidSize() {
      return request.resource.size < 20 * 1024 * 1024;
    }

    // ─────────────────────────────────────────────────────────────────────
    // campaign_banners/{allPaths=**} — Ad campaign banners
    // ─────────────────────────────────────────────────────────────────────
    match /campaign_banners/{allPaths=**} {
      allow read: if true;
      allow create, update, write: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // ─────────────────────────────────────────────────────────────────────
    // business_documents/{allPaths=**}
    // ─────────────────────────────────────────────────────────────────────
    match /business_documents/{allPaths=**} {
      allow read: if isSignedIn();
      allow create, update, write: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // ─────────────────────────────────────────────────────────────────────
    // offers/{allPaths=**}
    // ─────────────────────────────────────────────────────────────────────
    match /offers/{allPaths=**} {
      allow read: if true;
      allow create, update, write: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // ─────────────────────────────────────────────────────────────────────
    // shops/{allPaths=**}
    // ─────────────────────────────────────────────────────────────────────
    match /shops/{allPaths=**} {
      allow read: if true;
      allow create, update, write: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // ─────────────────────────────────────────────────────────────────────
    // users/{uid}/{fileName} — User profile photos / avatars
    // ─────────────────────────────────────────────────────────────────────
    match /users/{uid}/{fileName} {
      allow read: if true;
      allow create, update, delete: if isOwner(uid)
          && request.resource.contentType.matches('image/(jpeg|png|jpg|webp)')
          && request.resource.size < 5 * 1024 * 1024;
    }

    // ─────────────────────────────────────────────────────────────────────
    // banners/{fileName}
    // ─────────────────────────────────────────────────────────────────────
    match /banners/{fileName} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // ─────────────────────────────────────────────────────────────────────
    // hotspots/{fileName}
    // ─────────────────────────────────────────────────────────────────────
    match /hotspots/{fileName} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // ─────────────────────────────────────────────────────────────────────
    // promo_banners/{fileName}
    // ─────────────────────────────────────────────────────────────────────
    match /promo_banners/{fileName} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // ─────────────────────────────────────────────────────────────────────
    // categories/{fileName} — Category icons
    // ─────────────────────────────────────────────────────────────────────
    match /categories/{fileName} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // ─────────────────────────────────────────────────────────────────────
    // brands/{fileName} — Brand logos
    // ─────────────────────────────────────────────────────────────────────
    match /brands/{fileName} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // ─────────────────────────────────────────────────────────────────────
    // Default deny
    // ─────────────────────────────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
